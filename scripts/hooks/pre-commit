#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Honor filenames supplied by pre-commit, including --all-files and --files.
if (( $# == 0 )); then
  staged=$(mktemp)
  trap 'rm -f "$staged"' EXIT
  git diff --cached --name-only --diff-filter=ACMR -z > "$staged"
  mapfile -d '' -t files < "$staged"
else
  files=("$@")
fi

# Do not git add: pre-commit detects edits and asks the user to stage them.
# This also protects unstaged changes when pre-commit restores its stash.
python3 scripts/lib/image_metadata.py -- "${files[@]}"
